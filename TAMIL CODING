  <script>
    const questions = [...document.querySelectorAll(".question")];
    const buttons = [...document.querySelectorAll(".answer-button")];
    const screens = {
      start: document.getElementById("start-screen"),
      quiz: document.getElementById("quiz-screen"),
      results: document.getElementById("results-screen")
    };
    const tamilDigits = "௦௧௨௩௪௫௬௭௮௯";
    const inTamil = number => String(number).replace(/[0-9]/g, digit => tamilDigits[Number(digit)]);
    let order = [];
    let current = 0;
    let score = 0;
    let answered = false;
    let advanceTimer;

    function showScreen(name) {
      Object.entries(screens).forEach(([key, screen]) => {
        screen.classList.toggle("active", key === name);
        screen.classList.remove("pop-in");
      });
      screens[name].classList.add("pop-in");
    }

    function shuffleQuestions() {
      order = [...questions];
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }
    }

    function displayQuestion() {
      answered = false;
      questions.forEach(question => question.classList.add("hidden"));
      order[current].classList.remove("hidden");
      buttons.forEach(button => {
        button.disabled = false;
        button.classList.remove("chosen-correct", "chosen-incorrect");
      });
      document.getElementById("correct-feedback").classList.add("hidden");
      document.getElementById("incorrect-feedback").classList.add("hidden");
      document.getElementById("progress-text").textContent =
        `கேள்வி ${current + 1}/${20}`;
      document.getElementById("progress-fill").style.width = `${(current / 20) * 100}%`;
      document.getElementById("progress-bar").setAttribute("aria-valuenow", current);
    }

    function startGame() {
      clearTimeout(advanceTimer);
      current = 0;
      score = 0;
      shuffleQuestions();
      showScreen("quiz");
      displayQuestion();
    }

    function showResults() {
      document.getElementById("total-value").textContent = inTamil(20);
      document.getElementById("correct-value").textContent = inTamil(score);
      document.getElementById("incorrect-value").textContent = inTamil(20 - score);
      document.getElementById("marks-value").textContent = `${inTamil(score)} / ${inTamil(20)}`;
      document.getElementById("percentage-value").textContent = `${inTamil(score * 5)}%`;
      document.querySelectorAll(".score-message").forEach(message => message.classList.add("hidden"));
      const messageId = score >= 18 ? "message-excellent" :
        score >= 14 ? "message-great" :
        score >= 10 ? "message-good" : "message-keep-going";
      document.querySelector(`[data-template-id="${messageId}"]`).classList.remove("hidden");
      showScreen("results");
    }

    buttons.forEach(button => button.addEventListener("click", () => {
      if (answered) return;
      answered = true;
      buttons.forEach(option => { option.disabled = true; });
      const correct = button.dataset.answer === order[current].dataset.answer;
      if (correct) score++;
      button.classList.add(correct ? "chosen-correct" : "chosen-incorrect");
      document.getElementById(correct ? "correct-feedback" : "incorrect-feedback").classList.remove("hidden");
      advanceTimer = setTimeout(() => {
        current++;
        if (current === 20) showResults();
        else displayQuestion();
      }, 1400);
    }));

    document.getElementById("start-button").addEventListener("click", startGame);
    document.getElementById("replay-button").addEventListener("click", startGame);
    document.getElementById("home-button").addEventListener("click", () => {
      clearTimeout(advanceTimer);
      showScreen("start");
    });
  </script>
